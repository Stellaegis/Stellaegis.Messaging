<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Messaging</RootNamespace>
    <PackageId>Stellaegis.Messaging</PackageId>
    <Description>Stellaegis messaging core: EmailMessage/IEmailSender contracts, configuration per space in a vault, from-policy and a reliable outbox.</Description>
    <PackageTags>stellaegis;messaging;email</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Stellaegis.Caching" />
    <PackageReference Include="Stellaegis.Primitives" />
    <PackageReference Include="Stellaegis.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stellaegis.Messaging.Tests" />
  </ItemGroup>

</Project>
