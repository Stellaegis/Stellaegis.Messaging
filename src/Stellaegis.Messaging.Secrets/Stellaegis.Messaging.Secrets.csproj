<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Messaging.Secrets</RootNamespace>
    <PackageId>Stellaegis.Messaging.Secrets</PackageId>
    <Description>Messaging configuration per compartment in a Stellaegis.Secrets vault, for Stellaegis.Messaging: cached resolution, eviction by secret path, and an editing store that masks credentials.</Description>
    <PackageTags>stellaegis;messaging;email;secrets;vault</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Stellaegis.Caching" />
    <PackageReference Include="Stellaegis.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stellaegis.Messaging\Stellaegis.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stellaegis.Messaging.Tests" />
  </ItemGroup>

</Project>
