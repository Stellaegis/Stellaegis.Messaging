<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Messaging.Smtp</RootNamespace>
    <PackageId>Stellaegis.Messaging.Smtp</PackageId>
    <Description>SMTP transport for Stellaegis.Messaging via MailKit (Basic and client-certificate authentication).</Description>
    <PackageTags>stellaegis;messaging;email;smtp;mailkit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stellaegis.Messaging\Stellaegis.Messaging.csproj" />
  </ItemGroup>

</Project>
