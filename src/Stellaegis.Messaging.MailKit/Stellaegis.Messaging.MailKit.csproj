<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Messaging.MailKit</RootNamespace>
    <PackageId>Stellaegis.Messaging.MailKit</PackageId>
    <Description>SMTP transport for Stellaegis.Messaging, on MailKit: Basic or client-certificate authentication, explicit envelope sender.</Description>
    <PackageTags>stellaegis;messaging;email;smtp;mailkit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <!-- MimeKit, under MailKit 4.18.1, asks for 10.0.0, which has known vulnerabilities (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7). A direct reference carries the fixed version into the package's dependencies, so
         that consumers get it too. Remove it once MailKit asks for a fixed version itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stellaegis.Messaging\Stellaegis.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stellaegis.Messaging.Tests" />
  </ItemGroup>

</Project>
