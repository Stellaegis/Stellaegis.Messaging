<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test projects ship no public API surface — no XML doc, and the per-call token nag adds no value. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stellaegis.Messaging\Stellaegis.Messaging.csproj" />
    <ProjectReference Include="..\..\src\Stellaegis.Messaging.MailKit\Stellaegis.Messaging.MailKit.csproj" />
    <ProjectReference Include="..\..\src\Stellaegis.Messaging.PostgreSQL\Stellaegis.Messaging.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\Stellaegis.Messaging.Secrets\Stellaegis.Messaging.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\sql\stellaegis_messaging.sql" Link="sql\stellaegis_messaging.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
